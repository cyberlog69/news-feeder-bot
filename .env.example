# ════════════════════════════════════════════════════════
#  News Feeder Bot v3.0 — Environment Configuration
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to version control!
# ════════════════════════════════════════════════════════


# ════════════════════════════════════════════════════════
#  AI SUMMARIZATION — Choose ONE primary provider
#  Options: groq | gemini | cerebras | mistral | cohere | cloudflare | openrouter | ollama | huggingface | extractive
#  (Bot automatically auto-cascades to all configured providers if any fails!)
# ════════════════════════════════════════════════════════

SUMMARIZER_PROVIDER=groq       # ← change this to switch primary provider


# ── 1. Groq Cloud (RECOMMENDED — free 14,400 req/day, ultra-fast 300ms) ────────
# Sign up free at: https://console.groq.com/keys
# Free models: llama-3.3-70b-versatile, mixtral-8x7b-32768, gemma2-9b-it
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile


# ── 2. Google Gemini (1,500 req/day free — high quality, native REST) ──────────
# Get free key at: https://aistudio.google.com/app/apikey (starts with AIzaSy...)
# Free models: gemini-1.5-flash, gemini-2.0-flash, gemini-2.5-flash
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash


# ── 3. Cerebras Cloud (1,000,000 tokens/day free — 2,000+ tokens/sec) ─────────
# Sign up free at: https://cloud.cerebras.ai
# Free models: llama3.3-70b, llama3.1-8b
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama3.3-70b


# ── 4. Mistral AI (Free Experimentation Tier) ──────────────────────────────────
# Sign up free at: https://console.mistral.ai
# Free models: mistral-small-latest, open-mistral-nemo
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest


# ── 5. Cohere (1,000 free calls/month — purpose-built text summarizer) ─────────
# Sign up free at: https://dashboard.cohere.com/api-keys
# Free models: command-r, command-r-plus, command-light
COHERE_API_KEY=
COHERE_MODEL=command-r


# ── 6. Cloudflare Workers AI (10,000 neurons/day free on global edge) ─────────
# Get token at: https://dash.cloudflare.com → Workers & AI → API Tokens
# Free models: @cf/meta/llama-3.3-70b-instruct, @cf/meta/llama-3.1-8b-instruct
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct


# ── 7. OpenRouter (Unified gateway with auto-discovered free models) ──────────
# Sign up free at: https://openrouter.ai
OPENROUTER_API_KEY=


# ── 8. Ollama (LOCAL — unlimited, 100% free, full privacy, runs on your VM) ────
# Install from: https://ollama.com
# Pull model:   ollama pull llama3.2
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2


# ── 9. Hugging Face Inference API ─────────────────────────────────────────────
# Sign up free at: https://huggingface.co/settings/tokens
HF_API_KEY=
HF_MODEL=facebook/bart-large-cnn


# ── 10. Extractive (NO AI — deterministic sentence extraction, 0ms, offline) ───
# Set SUMMARIZER_PROVIDER=extractive for zero external API dependencies


# ════════════════════════════════════════════════════════
#  PLATFORM CONFIGURATION
#  Set at least ONE platform. Multiple platforms work simultaneously.
# ════════════════════════════════════════════════════════

# ── WhatsApp (Optional) ───────────────────────────────────
# Supports comma-separated multiple targets:
#   Phone number:  919876543210
#   Group ID:      120363409960337815@g.us
#   Group name:    My Cyber News Group
#   Multi-target:  120363@g.us,919876543210
#
# Run 'npm run list-groups' to find your group IDs.
WHATSAPP_TARGET=


# ── Telegram (Optional) ───────────────────────────────────
# Step 1: Message @BotFather on Telegram → /newbot → copy token
# Step 2: Run 'npm run list-telegram-chats' to find your chat ID
#
# Supports comma-separated multiple targets:
#   Personal chat:   123456789
#   Group:          -987654321
#   Channel:        @mychannel  OR  -1001234567890
#   Multi-target:   @mychannel,-1001234567890
TELEGRAM_BOT_TOKEN=
TELEGRAM_TARGET=


DISCORD_WEBHOOK_URL=
DISCORD_USERNAME=📰 News Feeder Bot
# Optional: URL to a custom avatar image for the Discord bot
DISCORD_AVATAR_URL=


# ── Google Chat Space / Hangouts (Optional) ───────────────
# Step 1: Open Google Chat Space → Space Title → Apps & Integrations → Webhooks → Add Webhook
# Step 2: Copy the generated Webhook URL and paste below
GOOGLE_CHAT_WEBHOOK_URL=


# ── Slack (Optional) ──────────────────────────────────────
# Step 1: Slack App → Incoming Webhooks → Activate → Add New Webhook to Workspace
# Step 2: Copy Webhook URL and paste below
SLACK_WEBHOOK_URL=


# ── Microsoft Teams (Optional) ────────────────────────────
# Step 1: Teams Channel → Connectors / Workflows → Incoming Webhook → Copy URL
TEAMS_WEBHOOK_URL=

# ── HTML Email Newsletter (Optional) ──────────────────────
# Send formatted HTML email newsletters via SendGrid / Resend API or SMTP.
# EMAIL_PROVIDER options: sendgrid | resend | smtp  (default: sendgrid)
#   sendgrid → set SENDGRID_API_KEY
#   resend  → set RESEND_API_KEY
#   smtp    → set SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS (and SENDGRID_API_KEY can be left blank)
EMAIL_TO=
EMAIL_FROM=newsbot@example.com
EMAIL_API_KEY=
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Mobile Push Notifications (Optional) ──────────────────
# Option A: Ntfy.sh (100% free — no account required)
NTFY_TOPIC_URL=

# Option B: Pushover (Pushover.net app)
PUSHOVER_USER_KEY=
PUSHOVER_API_TOKEN=

# ── Outbound Webhooks for SOAR / SIEM (Optional) ──────────
# Broadcasts structured JSON threat payloads to n8n, Zapier, Splunk, Shuffle SOAR
OUTBOUND_WEBHOOK_URL=
OUTBOUND_WEBHOOK_SECRET=


# ════════════════════════════════════════════════════════
#  DEPLOYMENT / INFRASTRUCTURE
# ════════════════════════════════════════════════════════

# NODE_ENV — set to 'production' on cloud deployments
# NODE_ENV=production

# PORT — auto-set by cloud platforms (Railway, Render, Fly.io)
# PORT=3000

# DASHBOARD_TOKEN — protect the /trigger endpoint (recommended on cloud deployments)
# Leave empty to allow unauthenticated access (fine on localhost)
# Generate one: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# DASHBOARD_TOKEN=your_secret_token_here

# CHROME_PATH — override Chrome binary path (useful on VPS/Docker)
# CHROME_PATH=/usr/bin/google-chrome

# WWEBJS_AUTH_PATH — override WhatsApp auth directory (for Docker/Fly/Render volumes)
# Docker Compose sets this to /app/.wwebjs_auth automatically; on Fly/Render it is /app/data/.wwebjs_auth
# WWEBJS_AUTH_PATH=/data/.wwebjs_auth
