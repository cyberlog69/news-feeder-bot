{
  "name": "news-feeder-bot",
  "version": "3.17.0",
  "description": "Automated cybersecurity & tech news delivery to WhatsApp, Telegram, and Discord",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "start:prod": "NODE_ENV=production node index.js",
    "dev": "node --watch index.js",
    "pm2:start": "pm2 start ecosystem.config.js --env production",
    "pm2:stop": "pm2 stop news-feeder-bot",
    "pm2:restart": "pm2 restart news-feeder-bot",
    "pm2:reload": "pm2 reload news-feeder-bot",
    "pm2:logs": "pm2 logs news-feeder-bot",
    "pm2:monit": "pm2 monit",
    "pm2:delete": "pm2 delete news-feeder-bot",
    "docker:build": "docker build -t news-feeder-bot .",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:restart": "docker-compose restart",
    "docker:pull": "docker-compose pull",
    "podman:build": "podman build -t news-feeder-bot .",
    "podman:up": "podman-compose up -d",
    "podman:down": "podman-compose down",
    "podman:logs": "podman-compose logs -f",
    "podman:restart": "podman-compose restart",
    "add-source": "node add-source.js",
    "list-groups": "node list-groups.js",
    "list-telegram-chats": "node list-telegram-chats.js",
    "test-ai": "node scripts/test-ai.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "audit": "npm audit",
    "audit:fix": "npm audit fix"
  },
  "keywords": [
    "whatsapp",
    "telegram",
    "discord",
    "news",
    "automation",
    "cybersecurity",
    "rss",
    "bot"
  ],
  "dependencies": {
    "@extractus/article-extractor": "^8.0.0",
    "@google/generative-ai": "^0.24.1",
    "dotenv": "^17.4.2",
    "node-cron": "^4.5.0",
    "nodemailer": "^10.1.0",
    "qrcode-terminal": "^0.12.0",
    "rss-parser": "^3.13.0",
    "whatsapp-web.js": "^1.23.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "brace-expansion": "^5.0.12",
    "source-map-js": "^1.2.2",
    "postcss": "^8.5.25",
    "ip-address": "^10.3.1",
    "js-yaml": "^4.1.1",
    "nanoid": "^3.3.18",
    "puppeteer": "^25.6.0",
    "nodemailer": "^10.1.0",
    "sanitize-html": "^2.17.7"
  },
  "allowScripts": {
    "puppeteer@25.6.0": true,
    "puppeteer@24.38.0": true
  }
}
